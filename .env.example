# Copy to .env and fill in real values.
#   cp .env.example .env
# .env is gitignored and never committed. This file holds no real values.
#
# The configs reference the variable NAME only, never a value:
#   config/models.yaml  ->  llm.api_key_env: GEMINI_API_KEY
#   config/corpus.yaml  ->  source.api_key_env: OPENALEX_API_KEY

# Google AI Studio. All four LLM tasks (abstractor, decomposer, skeptic, translator).
# Free tier, no balance needed, but the rate limit is the binding constraint: at
# llm.concurrency 8 it returned 429 then 503 within a few calls. See
# docs/llm_gateway_spec.md rule 18.
GEMINI_API_KEY=

# OpenAlex. Corpus ingest: seeds, classics, stratified sample.
OPENALEX_API_KEY=

# --- Optional stage switches, see docs/llm_gateway_spec.md ---
# LLM_CACHE_ONLY=1   # a cache miss raises instead of calling the API. Use on stage.
# LLM_DRY_RUN=1      # return fixtures from tests/fixtures/{task}.json, so the API
#                    # and UI work with no key and no network.