{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Translator",
  "type": "object",
  "additionalProperties": false,
  "required": ["hypothesis", "source_passage", "mapping", "reviewer_note"],
  "properties": {
    "hypothesis": { "type": "string", "minLength": 10 },
    "source_passage": { "type": "string", "minLength": 10 },
    "mapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_concept", "home_concept"],
        "properties": {
          "source_concept": { "type": "string", "minLength": 2 },
          "home_concept": { "type": "string", "minLength": 2 }
        }
      }
    },
    "reviewer_note": { "type": "string", "minLength": 10 }
  }
}
